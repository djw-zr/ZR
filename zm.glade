                      </object>
                      <packing>
                        <property name="x">10</property>
                        <property name="y">120</property>
                      </packing>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="label">
              <object class="GtkLabel" id="Label4">
                <property name="visible">True</property>
